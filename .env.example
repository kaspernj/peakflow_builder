# Port exposing the TLS-protected Docker daemon for this builder.
HOST_PORT=8676

# Default/non-Switch builders: do not run a local registry-cache service.
# Point Docker at the single registry cache on Switch instead.
COMPOSE_PROFILES=
REGISTRY_CACHE_HOST=192.168.86.82
REGISTRY_CACHE_PORT=5000

# Switch only: uncomment these values to run and expose the registry cache.
# COMPOSE_PROFILES=registry-cache
# REGISTRY_CACHE_HOST=registry-cache
# REGISTRY_CACHE_BIND=192.168.86.82
