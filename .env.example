# Persist the Docker API mode across every bare docker compose command.
# Trusted home-network Socketduct builders replace this with:
# COMPOSE_FILE=docker-compose.yml:docker-compose.socketduct.yml
COMPOSE_FILE=docker-compose.yml

# Base/off-home mode port exposing the TLS-protected Docker daemon.
# The Socketduct override clears this host binding.
HOST_PORT=8676

# Default/non-Switch builders: do not run a local registry-cache service.
# Point Docker at the single registry cache on Switch instead.
COMPOSE_PROFILES=

# Docker daemon endpoint for the central registry cache.
REGISTRY_CACHE_HOST=192.168.86.82
REGISTRY_CACHE_PORT=5000

# Host directory containing Docker registry trust roots. Place each CA at:
#   <directory>/<registry-host>:<port>/ca.crt
DOCKER_REGISTRY_CERTS_DIR=./shared/docker-certs.d

# Switch only: uncomment these values to run and expose the registry cache.
# The registry container always listens on port 5000 inside the Compose network.
# REGISTRY_CACHE_BIND_PORT is its separately configurable LAN-facing host port.
# COMPOSE_PROFILES=registry-cache
# REGISTRY_CACHE_HOST=registry-cache
# REGISTRY_CACHE_BIND=192.168.86.82
# REGISTRY_CACHE_BIND_PORT=5000
